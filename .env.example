# Server Configuration
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/alphapath_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alphapath_db
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Configuration
JWT_SECRET=your_super_secret_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=another_secret_key_for_refresh_tokens_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Paystack Configuration (Ghana Mobile Money)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=alphapath-media
AWS_CLOUDFRONT_URL=https://your-cloudfront-domain.cloudfront.net

# Cloudflare Stream Configuration (Video)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Firebase Configuration (Push Notifications)
FIREBASE_PROJECT_ID=alphapath-academy
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@alphapath-academy.iam.gserviceaccount.com

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@alphapath.com

# Redis Configuration (Optional)
REDIS_URL=redis://localhost:6379

# Client URL (for payment redirects)
CLIENT_URL=http://localhost:3000

# Monitoring Configuration
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,https://alphapath.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
